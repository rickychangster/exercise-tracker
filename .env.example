# ── Access gate (recommended) ───────────────────────────────────────────────
# If set, the app prompts for this passphrase once and stores a cookie.
# Leave BLANK to run fully open (demo mode) — fine only if the URL stays private.
ACCESS_PASSPHRASE=

# ── Backend: pick ONE of the two options below ──────────────────────────────

# Option A — Apps Script (easiest: no Google Cloud project, no service account)
# Deploy apps-script/Code.gs as a Web App and paste its /exec URL here.
# APPS_SCRIPT_URL=
# APPS_SCRIPT_TOKEN=        # optional shared secret (matches the script's TOKEN)

# Option B — Google Sheets API via service account
# SHEET_ID: the spreadsheet id (or full URL — the app extracts the id).
# SHEET_ID=
# GOOGLE_SA_KEY: the service-account JSON (raw JSON or base64 of it).
# GOOGLE_SA_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
# Default timezone for "day" boundaries (overridden by the meta tab if present).
APP_TIMEZONE=America/Los_Angeles
